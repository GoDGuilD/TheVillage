# File: PixelText.gd
# Description: Draws text from the generated bitmap fonts (5x7 and 3x5 atlases, ASCII plus the Spanish letters) with a tint, optional drop shadow and alignment, translated into the current language by Loc; static helpers measure text and word-wrap it to a pixel width.
# Author: Jose-Jorge HERNANDEZ
# Company: Parlee Conseiller, Inc.
# Date: 2026-10-15
# Last edit date: 2026-10-21
# Version: 1.1.0
class_name PixelText
extends Node2D
## Ported from Chapel of Dreams (same fonts, generated by tools/gen_ui.py). `text` is given in English: it keeps
## that `source` and shows Loc.t(source) - unless `translate` is off (dialogue lines, already in the reader's
## language). Every node joins Loc.LIVE_GROUP so a language change re-translates open screens (`retranslate`).

enum Align { LEFT, CENTER, RIGHT }

const FONT_DIR := "res://assets/ui/"
const FONT_LARGE := "5x7"
const FONT_SMALL := "3x5"
const SHADOW_COLOR := Color(0.03, 0.03, 0.08, 0.85)
const SHADOW_OFFSET := Vector2(1, 1)
const DEFAULT_ADVANCE_LARGE := 6
const DEFAULT_ADVANCE_SMALL := 4

# font name -> {texture, cell (Vector2i), columns, first, advance (Dictionary char -> px), default_advance}
static var _fonts: Dictionary = {}

var source := ""                         # the text as given (English), before translation
var translate := true                    # false: draw `source` as is (set it before `text`)
var text := "":
	set(value):
		source = value
		text = Loc.t(value) if translate else value
		queue_redraw()
var font := FONT_LARGE:
	set(value):
		font = value
		queue_redraw()
var color := Color.WHITE:
	set(value):
		color = value
		queue_redraw()
var shadow := true:
	set(value):
		shadow = value
		queue_redraw()
var align := Align.LEFT:
	set(value):
		align = value
		queue_redraw()


# Convenience constructor: a ready-to-add text node.
static func make(content: String, pos: Vector2, tint: Color = Color.WHITE, font_name: String = FONT_LARGE, alignment: Align = Align.LEFT) -> PixelText:
	var t := PixelText.new()
	t.position = pos
	t.color = tint
	t.font = font_name
	t.align = alignment
	t.text = content
	return t


func _init() -> void:
	add_to_group(Loc.LIVE_GROUP)


# The language changed: draw the source again in the new one.
func retranslate() -> void:
	if translate:
		text = source


static func _data(font_name: String) -> Dictionary:
	if not _fonts.has(font_name):
		var json: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(FONT_DIR + "font_%s.json" % font_name))
		var adv: Variant = json.get("advance", {})
		_fonts[font_name] = {
			"texture": load(FONT_DIR + "font_%s.png" % font_name),
			"cell": Vector2i(json["cell"][0], json["cell"][1]),
			"columns": int(json["columns"]),
			"first": int(json["first_char"]),
			"advance": adv if adv is Dictionary else {},
			"default_advance": DEFAULT_ADVANCE_LARGE if font_name == FONT_LARGE else DEFAULT_ADVANCE_SMALL,
		}
	return _fonts[font_name]


# Pixel width of `content` in `font_name`.
static func measure(content: String, font_name: String = FONT_LARGE) -> int:
	var d := _data(font_name)
	var w := 0
	for ch in content:
		w += int(d["advance"].get(ch, d["default_advance"]))
	return w


static func line_height(font_name: String = FONT_LARGE) -> int:
	return _data(font_name)["cell"].y


# Greedy word wrap of `content` into lines no wider than `max_px`; "\n" forces a break. A single word wider
# than the line is left on its own line rather than split.
static func wrap(content: String, max_px: int, font_name: String = FONT_LARGE) -> Array[String]:
	var lines: Array[String] = []
	for paragraph in content.split("\n"):
		var line := ""
		for word in paragraph.split(" ", false):
			var candidate := word if line == "" else line + " " + word
			if line != "" and measure(candidate, font_name) > max_px:
				lines.append(line)
				line = word
			else:
				line = candidate
		lines.append(line)
	return lines


func _draw() -> void:
	if text == "":
		return
	var d := _data(font)
	var tex: Texture2D = d["texture"]
	var cell: Vector2i = d["cell"]
	var x := 0.0
	match align:
		Align.CENTER:
			x = -float(measure(text, font) / 2)
		Align.RIGHT:
			x = -float(measure(text, font))
	if shadow:
		_draw_run(tex, cell, d, Vector2(x, 0) + SHADOW_OFFSET, SHADOW_COLOR)
	_draw_run(tex, cell, d, Vector2(x, 0), color)


func _draw_run(tex: Texture2D, cell: Vector2i, d: Dictionary, origin: Vector2, tint: Color) -> void:
	var pen := origin
	for ch in text:
		var code := ch.unicode_at(0) - int(d["first"])
		if code >= 0 and ch != " ":
			var src := Rect2((code % d["columns"]) * cell.x, (code / d["columns"]) * cell.y, cell.x, cell.y)
			draw_texture_rect_region(tex, Rect2(pen.round(), Vector2(cell)), src, tint)
		pen.x += d["advance"].get(ch, d["default_advance"])

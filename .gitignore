# Godot's generated cache/import data (rebuilt on open)
.godot/
# Android export scaffolding (not used; generated by the editor if ever enabled)
/android/
# Export output
build/
# Local timestamped backups (non-git safety net; never committed)
backups/
# Scratch space and generator previews (keep the folder itself)
tmp/*
!tmp/.gitkeep
# Compiled Python caches from the tools/ scripts
__pycache__/
*.pyc

# --- added by security audit patch (2026-07-08) ---
# JavaScript dependencies (none today; guard against accidental installs)
node_modules/
# Secrets / env files - never committed
.env
.env.*
.dev.vars
.dev.vars.*
# Cloudflare wrangler local state
.wrangler/

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp
